{
    "lock": true,
    "importMap": "./common/deps.json",
    "compilerOptions": {
        "lib": [
            "dom",
            "deno.ns"
        ]
    },
    "tasks": {
        "dev:game": "cd server && deno task dev:game",
        "dev:api": "cd server && deno task dev:api",
        "dev:client": "cd client && deno task dev",
        "dev":"deno task dev:game & deno task dev:api & deno task dev:client",

        "optmise:svg":"npx svgo client/public/assets/img -r --multipass",
        "build:client": "cd client && npx vite build",
        "build:electron": "cd desktop && deno task build:electron",
        "build:android": "cd desktop && deno task build:android",
        "build:desktop": "cd desktop && deno task build",

        "install":"npm install --save-dev nodemon ts-node"
    }
}