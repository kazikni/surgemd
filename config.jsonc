{
    "api": {
        "host": {
            "port": 8000,
            "ssl": false,
            "cert": "./private/api/certificate.crt",
            "key": "./private/api/private.key",
            "ca": "./private/api/ca_bundle.crt"
        },
        "users": {
            "region": {
                "password": "region",
                "permitions": {
                    "allow_region": true
                }
            }
        },
        "game": {
            "modes": [
                {
                    "group_size": [
                        1
                    ],
                    "mode": {
                        "mode": "normal"
                    }
                },
                {
                    "group_size": [
                        2
                    ],
                    "mode": {
                        "mode": "normal",
                        "name": "modes.tundra",
                        "settings": {
                            "map": {
                                "def": "tundra"
                            }
                        }
                    }
                }
            ]
        }
    },
    "game": {
        "max_games": 6,
        "tps": 100,
        "ntps": 32,
        "debug": {
            "debug_menu": true
        },
        "host": {
            "port": 8080,
            "ssl": false,
            "cert": "./private/game/certificate.crt",
            "ca": "./private/game/ca_bundle.crt",
            "key": "./private/game/private.key"
        },
        "region": {
            "name": "local",
            "ip": "localhost"
        },
        "authentication": {
            "server": "ws://localhost:8000/regions/ws",
            "user": {
                "name": "region",
                "password": "region"
            }
        }
    },
    "vite": {
        "port": 3000,
        "allowed_hosts": true,
        "spritesheet": {
            "sheets": {
                "main": "img/game/main",
                "common": "img/game/common",
                "snow": "img/game/snow"
            },
            "resolutions": [
                {
                    "name": "low",
                    "scale": 0.5
                },
                {
                    "name": "medium",
                    "scale": 1
                }
            ]
        },
        "audios": [
            {
                "input": "sounds/game/main",
                "output": "assets/main-sounds.json"
            }
        ]
    }
}