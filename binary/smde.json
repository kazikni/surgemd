{
    "name":"surgemd-binary",
    "version":"1.0",
    "task":{
        "dev":{
            "task":"go run main.go dev"
        },
        "run": {
            "task":"go run main.go dev"
        },
        "build": {
            "windows":[
                "rmdir /S /Q dist",
                "mkdir dist build",
                "mkdir dist/mods",
                "mkdir dist/files",
                "robocopy mods dist/mods /E",
                "cd ../client && npx vite build && robocopy dist ../binary/dist/files /E",
                "go build -ldflags=-H=windowsgui -o dist/surgemd.exe",
                "rmdir /S /Q build",
                "cd ../server && smde task build && robocopy dist ../binary/dist /E"
            ]
        }
    }
}