{
  "tasks": {
    "dev:game": "deno run --watch -A src/deno.ts game start --config-file \"../config.jsonc\"",
    "dev:api": "deno run --watch -A src/deno.ts api start --config-file \"../config.jsonc\"",
    "dev": "deno task dev:game & deno task dev:api",
    "build": "deno compile ./src/main.ts",
    "bundle:cli":"deno bundle -o dist/cli.js src/cli.ts",
    "test:stress": "deno run -A ./src/test/stress_test.ts"
  },
  "importMap": "../common/deps.json",
  "nodeModulesDir":"auto",
  "dependencies": {
    "napi-rs/canvas": "1.0.8"
  }
}